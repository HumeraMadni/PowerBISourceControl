	measure 'Average Copay' = AVERAGE(GOLD_LAYER_FINAL_STATUS[PATIENT_PAY])
		lineageTag: 205b7b33-50d3-4d53-b949-0f5f9283b758

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HCP Priority Sort' =
			
			VAR Flag24K = [High Potential Flag Creon 24K Flag]
			VAR Flag36K = [High Potential Creon 36K Flag]
			
			RETURN
			SWITCH(
			    TRUE(),
			    Flag24K = 1 && Flag36K = 1, 1,
			    Flag24K = 1 && Flag36K = 0, 2,
			    Flag24K = 0 && Flag36K = 1, 3,
			    Flag24K = 0 && Flag36K = 0, 4
			)
		formatString: 0
		lineageTag: 4de12827-3a04-465b-a19e-10147f586237

	measure 'Zenpep Conversion Legend' =
			
			"🟢 High: >60% Creon volume" & UNICHAR(10) &
			"🔴 Low: ≤60% Creon volume"
		lineageTag: 5f894d0d-03d6-45fb-ae67-3c5f4d131eb8

	measure 'Current Month Bar Color' =
			
			IF(
			    [Rolling 1M - Current] >= [Rolling 1M - Previous],
			    "#34A853",   -- Green
			    "#E85D5D"    -- Red
			)
		lineageTag: 488b83b4-6f75-4360-b530-ad1816d53bd7

	measure 'New to Product legend' =
			
			"New to Product:" & UNICHAR(10) & UNICHAR(10) &
			"🔵 Yes " & UNICHAR(10) &
			"🟡 No "
		lineageTag: 8757ff3c-8eda-45ac-a476-aaaca5927fe2

	measure 'Total HCPs' = DISTINCTCOUNT(GOLD_LAYER_FINAL_STATUS[PRACTITIONER_ID])
		formatString: 0
		lineageTag: 12269f0b-b14f-4a34-9045-e2552689e3a8

	measure 'Unique Payers' = DISTINCTCOUNT(GOLD_LAYER_PLAN[ADMIN_NAME])
		formatString: 0
		lineageTag: 225e028c-8e0d-4934-9f31-b799dfcc9827

	measure 'High Potential Territory Flag' =
			
			VAR TotalRX =
			    [Total RX Count]
			VAR ZenpepRX =
			    [Total Zenpep RX]
			RETURN
			    IF(
			        TotalRX > ZenpepRX,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 9a806f6a-04e7-4eaa-b249-50f80890cb64

	measure 'High Potential Territories' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('GOLD_LAYER_TERRITORY_HIERARCHY'[TERRITORY_ID_NAME]),
			        [High Potential Territory Flag] = 1
			    )
			)
		formatString: 0
		lineageTag: 013c9459-9862-4236-8cb9-6fe1bdfa823d

	measure 'Avg District RX' =
			
			CALCULATE(
			    AVERAGEX(
			        ALL(
			            'GOLD_LAYER_TERRITORY_HIERARCHY'[TERRITORY_ID]
			        ),
			        [Total RX Count]
			    ),
			    ALLEXCEPT(
			        'GOLD_LAYER_TERRITORY_HIERARCHY',
			        'GOLD_LAYER_TERRITORY_HIERARCHY'[DISTRICT_NAME]
			    )
			)
		lineageTag: 04ac4fe5-ff75-414c-bd0c-02a8679c42d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PERT volume above average' = [Total RX Count]- [Avg District RX]
		lineageTag: 96fb3732-5b08-403b-9094-7d65fa97dcd2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Above Average PERT Volume' =
			
			DIVIDE(
			    [PERT volume above average],
			    [Avg District RX],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 608d0751-ae99-4713-9b54-29579b7d7807

	measure 'Execution Priority' =
			
			IF(
			    [High Potential Territory Flag] = 1,
			    IF(
			        [% Above average PERT volume] > 0.25,
			        "High Priority",
			        "Medium Priority"
			    ),
			    "NA"
			)
		lineageTag: 57435313-2f18-4986-9b5c-806f0c8e8f8d

	measure 'Selected Period' =
			
			VAR StartDate =
			    MIN('DIM_DATE'[DATE])
			VAR EndDate =
			    MAX('DIM_DATE'[DATE])
			RETURN
			    IF(
			        StartDate = EndDate,
			        FORMAT(StartDate, "MMM yyyy"),
			        FORMAT(StartDate, "MMM yyyy") &
			        " – " &
			        FORMAT(EndDate, "MMM yyyy")
			    )
		lineageTag: 79715c3c-e253-4001-8ece-d2e2f6576894

	measure 'Zenpep Retail Share' =
			
			DIVIDE(
			    [Total Zenpep RX],
			    [Total RX Count]
			)
		lineageTag: 4e5d4268-7311-4bec-8925-3f2f5e083488

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 3 Territory Metric' =
			
			VAR TopTerritories =
			    TOPN(
			        3,
			        ALLSELECTED(
			            'GOLD_LAYER_TERRITORY_HIERARCHY'[TERRITORY_NAME]
			        ),
			        [Total Zenpep RX],
			        DESC
			    )
			RETURN
			    SUMX(
			        TopTerritories,
			        [Total Zenpep RX]
			    )
		lineageTag: b3e8d5d7-edc5-4495-92ab-950514957b76

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 3 Territory Share' =
			
			DIVIDE(
			    [Top 3 Territory Metric],
			    [Total Zenpep RX]
			)
		lineageTag: 98dbef41-3ff1-418a-8aac-1bedf36eebba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 3 Territories' =
			
			VAR TopTerritories =
			    TOPN(
			        3,
			        ALLSELECTED(
			            'GOLD_LAYER_TERRITORY_HIERARCHY'[TERRITORY_NAME]
			        ),
			        [Total Zenpep RX],
			        DESC
			    )
			RETURN
			    CONCATENATEX(
			        TopTerritories,
			        'GOLD_LAYER_TERRITORY_HIERARCHY'[TERRITORY_NAME],
			        ", ",
			        [Total Zenpep RX],
			        DESC
			    )
		lineageTag: 794cea5f-d2dd-4deb-a72d-8d386dc0221d

	measure 'Story Insight' =
			
			"For the selected period ("
			    & [Selected Period]
			    & "), Zenpep achieved a Retail Metric of "
			    & FORMAT(
			        DIVIDE([Total Zenpep RX], 1000000),
			        "0.00"
			    )
			    & "M, representing "
			    & FORMAT([Zenpep Retail Share], "0.0%")
			    & " of the total Retail Metric. The strongest performance was driven by "
			    & [Top 3 Territories]
			    & ", which together accounted for "
			    & FORMAT([Top 3 Territory Share], "0.0%")
			    & " of the total Zenpep Retail Metric."
		lineageTag: a1be4847-53f2-4183-ade4-bc04de207932

	measure 'High Priority Territories' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('GOLD_LAYER_TERRITORY_HIERARCHY'[TERRITORY_ID]),
			        [Execution Priority] = "High Priority"
			    )
			)
		formatString: 0
		lineageTag: fc1b7b49-1c99-4e6f-a490-62ee797eb6f5

	measure 'Zenpep Contribution %' =
			
			DIVIDE(
			    [Total Zenpep RX],
			    [Total RX Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5d170ea6-8b95-4784-91f3-097007540fe9

	measure 'HCP Conversion Flag' =
			
			IF(
			    [Zenpep Contribution %] > 0.70
			        && [% Refill] > 0.50,
			    1,
			    0
			)
		formatString: 0
		lineageTag: a6049d39-0434-4430-8159-ba7d5399824b

	measure 'HCP Conversion Icon' =
			
			IF(
			    ISBLANK([Zenpep Contribution %])
			        || ISBLANK([% Refill]),
			    "⚪",
			    IF(
			        [Zenpep Contribution %] > 0.70
			            && [% Refill] > 0.50,
			        "🟢",
			        "🔴"
			    )
			)
		lineageTag: 432f83a3-4702-47b6-8e70-88adf1510b1b

	measure 'HCP Refill Legend' =
			
			"High Refill Volume HCPs: " &
			"🟢 Zenpep Contribution >70% and Refill >50%   " &
			"🔴 Zenpep Contribution ≤70% or Refill ≤50%   " &
			"⚪ No Data"
		lineageTag: 8a5ed762-b73d-4ac0-a92c-9ffba85582b8

	measure 'Tooltip HCP Name' =
			
			SELECTEDVALUE(
			    'GOLD_LAYER_HCP_SHORT'[HCP_FULL_NAME]
			)
		lineageTag: 7ce8e31e-b676-4bd6-8c59-7d1d846a2628

	measure 'Average of PATIENT_PAY average per PATIENT_ID' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('GOLD_LAYER_FINAL_STATUS'[PATIENT_ID])),
				CALCULATE(AVERAGE('GOLD_LAYER_FINAL_STATUS'[PATIENT_PAY]))
			)
		lineageTag: df000208-ee8d-499a-bf42-adabfa477c55

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MeasureHolder
		lineageTag: 5a40b498-eaac-4a8a-ac7e-f53edae50171
		summarizeBy: none
		isNameInferred
		sourceColumn: [MeasureHolder]

		annotation SummarizationSetBy = Automatic

	partition MEASURES_TABLE = calculated
		mode: import
		source =
				DATATABLE (
				    "MeasureHolder", STRING,
				    {
				        { " " }
				    }
				)

	annotation PBI_Id = df6ecce8949c4c91ad7f54ed4ccc62a6

