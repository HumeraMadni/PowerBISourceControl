			    0
			)
		formatString: #,##0
		lineageTag: 6660c285-a269-4017-b44c-7876188a642e

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Claim Count (Coalesce)' =
			
			COALESCE(
