	measure 'HCP Conversion Flag' =
			
			IF(
			    [Zenpep Contribution %] > 0.70
			        && [% Refill] > 0.50,
			    1,
			    0
			)
		formatString: 0
		lineageTag: a6049d39-0434-4430-8159-ba7d5399824b

	measure 'HCP Conversion Icon' =
			
			IF(
			    ISBLANK([Zenpep Contribution %])
			        || ISBLANK([% Refill]),
			    "⚪",
			    IF(
			        [Zenpep Contribution %] > 0.70
			            && [% Refill] > 0.50,
			        "🟢",
			        "🔴"
			    )
			)
		lineageTag: 432f83a3-4702-47b6-8e70-88adf1510b1b

	measure 'HCP Refill Legend' =
			
			"High Refill Volume HCPs: " &
			"🟢 Zenpep Contribution >70% and Refill >50%   " &
			"🔴 Zenpep Contribution ≤70% or Refill ≤50% "
		lineageTag: 8a5ed762-b73d-4ac0-a92c-9ffba85582b8

	measure 'Tooltip HCP Name' =
			
			SELECTEDVALUE(
			    'GOLD_LAYER_HCP_SHORT'[HCP_FULL_NAME]
			)
		lineageTag: 7ce8e31e-b676-4bd6-8c59-7d1d846a2628

	measure 'Execution Priority Icon' =
			
			SWITCH(
			    [Execution Priority],
			    "High Priority", "🟢",
			    "Medium Priority", "🟡",
			    "NA", "🔴"
			)
		lineageTag: 4dcba2e1-ba09-4f87-bf9e-a52718f72919

	measure 'Execution Priority Legend' = ```
			
			"Execution Priority" & UNICHAR(10) & UNICHAR(10) &
			"🟢 High Priority: High Potential & >25% PERT volume" & UNICHAR(10) &
			"🟡 Medium Priority: High Potential & ≤25% PERT volume" & UNICHAR(10) &
			"🔴 NA"
			
			```
		lineageTag: 6c26c2fb-ce48-46d9-8993-5fb285ed8ff5

	measure 'Story Insights HTML' =
			
			VAR PeriodTxt =
			    "<b>" & [Selected Period] & "</b>"
			
			VAR RetailMetricTxt =
			    "<b>" &
			    FORMAT(
			        [Total Zenpep RX],
			        "#,##0"
			    ) &
			    "</b>"
			
			VAR RetailShareTxt =
			    "<b>" &
			    FORMAT([Zenpep RX Share], "0.0%") &
			    "</b>"
			
			VAR Top3Txt =
			    "<b>" &
			    [Top 3 Territories] &
			    "</b>"
			
			VAR Top3ShareTxt =
			    "<b>" &
			    FORMAT([Top 3 Territory Share], "0.0%") &
			    "</b>"
			
			RETURN
			    "For the selected period (" &
			    PeriodTxt &
			    "), Zenpep achieved a total RX of " &
			    RetailMetricTxt &
			    ", representing " &
			    RetailShareTxt &
			    " of the Total RX. The strongest performance was driven by " &
			    Top3Txt &
			    ", which together accounted for " &
			    Top3ShareTxt &
			    " of the Total Zenpep RX."
		lineageTag: 87539bec-865f-49d2-89bb-0d2f42189e09

	measure 'Low Potential Territories' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(Z2T_TARGET_LIST_Q2_2026[TERRITORY_ID]),
			        [High Potential Territory Flag] = 0
			    )
			)
		formatString: 0
		lineageTag: 98b29850-86b1-4e54-afed-b898dbe80154

	measure 'Total Claim Count Display' =
			
			FORMAT([Total Claim Count], "#,##0")
		lineageTag: 01bb1661-750b-44b7-b8bf-95eb51cf75c9

	measure 'Total Patients Display' =
			
			FORMAT([Total Patients], "#,##0")
		lineageTag: 6bac4ed3-b513-4936-bf09-38e26138d8d7

	measure 'Total RX Count Display' =
			
			FORMAT([Total RX Count], "#,##0")
		lineageTag: d2570e07-0950-4b05-a922-62be8773b1a7

	measure 'Total Zenpep RX Display' =
			
			FORMAT([Total Zenpep RX], "#,##0")
		lineageTag: b5b66e95-e559-470f-a32d-7fb056ca2d28

	measure 'Paid Claim Count Display' =
			
			FORMAT(
			    [Paid Claim Count],
			    "#,##0"
			)
		lineageTag: 7d9df360-5ebe-47ed-bd95-156718fc14e2

	measure 'Rejected Claim Count Display' =
			
			FORMAT(
			    [Rejected Claim Count],
			    "#,##0"
			)
		lineageTag: f4088595-4a5f-48d1-9ae6-8e352cb52213

	measure 'Reversed Claim Count Display' =
			
