			)
		formatString: 0
		lineageTag: df3f689f-6f66-494a-95c4-27873a318998

	measure 'High Potential Creon 36K HCP Count' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('GOLD_LAYER_HCP_SHORT'[PRACTITIONER_ID]),
