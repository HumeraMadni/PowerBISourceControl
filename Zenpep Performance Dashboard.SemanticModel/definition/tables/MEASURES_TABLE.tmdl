			)
		formatString: $#,##0.0
		lineageTag: 0aa5e643-d516-4214-8c08-b6de127ff2e6

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Paid Claim Count (Coalesce)' =
			
			COALESCE(
			    CALCULATE(
			        [Total Claim Count],
			        'CLAIM_STATUS'[CLAIM_STATUS_NUM] = 1
			    ),
			    0
			)
		formatString: #,##0
		lineageTag: 75bea41b-2f58-43e5-812e-6fbce8238cf2

