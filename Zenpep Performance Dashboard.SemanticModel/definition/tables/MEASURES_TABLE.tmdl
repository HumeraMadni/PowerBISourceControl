			)
		lineageTag: 4a399bcd-2860-4e83-abc2-aaa5c8f27f0b

	measure 'Average Copay Display' =
			
			FORMAT([Average Copay], "$ #,##0.0")
		lineageTag: 18dba199-b07d-44d4-a3f5-3799e97f2bd4

	measure 'Average OOP Display' =
			
			FORMAT([Average OOP], "$ #,##0.0")
		lineageTag: 1693028b-ad64-4a72-b47f-42d98d2c8b4f

	measure 'Execution Priority Sort' =
			
			VAR PriorityRank =
			    SWITCH(
			        [Execution Priority],
			        "High Priority", 1,
			        "Medium Priority", 2,
			        "NA", 3,
			        4
			    )
			
			VAR PERTPercent =
			    [% Above Average PERT Volume]
			
			RETURN
			    PriorityRank * 100000
			        - PERTPercent
		formatString: 0
		lineageTag: 0a517098-0ab8-4bd9-a6ee-c043b281e4ea

	measure 'Territory Potential Legend' =
			
			"Territory Potential:" & UNICHAR(10) & UNICHAR(10) &
			"🟢 High Potential" & UNICHAR(10) &
			"🔴 Low Potential"
		lineageTag: 8fb3dbfd-1ba5-4cd1-9ca5-4a528e3d1b2a

	measure 'Total RX Count (Coalesce)' =
			
			COALESCE(
			    SUM(GOLD_LAYER_FINAL_STATUS[RX_COUNT]),
			    0
			)
		formatString: #,##0.0
		lineageTag: 0e8193f6-4f64-4f8b-b5c4-03a8f20d00ef

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Patients (Coalesce)' =
			
			COALESCE(
