		formatString: 0
		lineageTag: ba8e289d-8d55-4480-aabe-77c99291b647

	measure 'Total Zenpep RX' =
			
			CALCULATE(
			    [Total RX Count],
			    'GOLD_LAYER_DRUG'[DRUG_NAME] = "ZENPEP"
			)
		formatString: 0.0
		lineageTag: 93b51893-c8f6-4171-ac0a-784c7b7b02c8

	measure 'Zenpep New to Brand RX' =
			
			CALCULATE(
			    [Total Zenpep RX],
			    GOLD_LAYER_FINAL_STATUS[NEW_TO_PRODUCT] = 1
			)
		formatString: 0.0
		lineageTag: e7c59ce5-34ca-445f-8ce0-002e58530fc3

	measure 'Zenpep Refill Volume' =
			
			[Total Zenpep RX] - [Zenpep New to Brand RX]
		formatString: 0.0
		lineageTag: a533dfc8-8318-4100-9ce9-26ebe0837a82

	measure '% Refill' =
			
			DIVIDE(
			    [Zenpep Refill Volume],
			    [Total Zenpep RX],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e47150cb-4d04-4d12-8713-53601b3c5ed6

	measure 'Claim % (HCP)' =
			
			DIVIDE(
			    [Total Claim Count],
			    CALCULATE(
			        [Total Claim Count],
			        ALL('GOLD_LAYER_HCP_SHORT')
			    ),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6f0d1d3b-f725-4c10-a4bb-28d1d2ab1bd6

	measure 'Rejected Claim Count' =
			
			CALCULATE(
			    [Total Claim Count],
			    'CLAIM_STATUS'[CLAIM_STATUS_NUM] = 0
			)
		formatString: 0
		lineageTag: bac37da1-2c46-4121-8a29-b2c60de1a23e

	measure 'Reversed Claim %' =
			
			DIVIDE(
			    [Reversed Claim Count],
			    [Total Claim Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c6a1b814-b796-46a3-b9be-ed188155aea2

	measure 'Rejected Claim %' =
			
			DIVIDE(
			    [Rejected Claim Count],
			    [Total Claim Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a2547573-dd47-4555-a3e7-f06feb947830

	measure 'HCP Rank' =
			
			RANKX(
			    ALLSELECTED('GOLD_LAYER_HCP_SHORT'[PRACTITIONER_ID]),
			    [Total Claim Count],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 4952fa01-39b1-4ffb-bc77-1006293e6226

	measure 'Tooltip Title' =
			
			"Patients with " &
			SELECTEDVALUE('CLAIM_STATUS'[CLAIM_STATUS]) &
			" Claims"
		lineageTag: 12b991cb-6b7b-4118-b8df-79911ff1a0b7

	measure 'Marker Color' =
			
			VAR LatestVisibleMonth =
			    MAXX (
			        ALLSELECTED ( 'DIM_DATE' ),
			        'DIM_DATE'[Month Year Sort]
			    )
			
			VAR CurrentMonth =
			    MAX ( DIM_DATE[Month Year Sort] )
			
			RETURN
			IF (
			    CurrentMonth = LatestVisibleMonth,
			    "#F28E2B",
			    "#808080"
			)
		lineageTag: 791cd73e-c156-4438-8982-920f065f0910

	measure 'Latest Selected Month' =
			
			CALCULATE(
			    MAX('DIM_DATE'[Date]),
			    ALLSELECTED('DIM_DATE')
			)
		formatString: General Date
		lineageTag: a35b062d-8b04-4355-8bd0-5e2a365e55e9

	measure 'Rolling 1M - Current' =
			
			VAR LatestMonth = [Latest Selected Month]
			
			VAR CurrentMonthStart =
			    EOMONTH(LatestMonth, -1) + 1
			
			VAR CurrentMonthEnd =
			    EOMONTH(LatestMonth, 0)
			
			RETURN
			CALCULATE(
			    [Total RX Count],
			    REMOVEFILTERS('DIM_DATE'),
			    DATESBETWEEN(
			        'DIM_DATE'[Date],
			        CurrentMonthStart,
			        CurrentMonthEnd
			    )
			)
		formatString: 0.0
		lineageTag: efee0523-8e95-49dc-abae-f0bd3612988a

	measure 'Rolling 1M - Previous' =
			
			VAR LatestMonth = [Latest Selected Month]
			
			VAR PreviousMonthStart =
			    EOMONTH(LatestMonth, -2) + 1
			
			VAR PreviousMonthEnd =
			    EOMONTH(LatestMonth, -1)
			
			RETURN
			CALCULATE(
			    [Total RX Count],
			    REMOVEFILTERS('DIM_DATE'),
			    DATESBETWEEN(
			        'DIM_DATE'[Date],
			        PreviousMonthStart,
			        PreviousMonthEnd
			    )
			)
		formatString: 0.0
		lineageTag: 5182ea9a-5f8b-4c42-8b81-5b0fbbeb436c

	measure 'Rolling 1M - MoM Display' =
			
			VAR CurrentValue =
			    [Rolling 1M - Current]
			
			VAR PreviousValue =
			    [Rolling 1M - Previous]
			
			VAR Change =
			    CurrentValue - PreviousValue
			
			VAR ChangePct =
			    DIVIDE(Change, PreviousValue)
			
			VAR Arrow =
			    SWITCH(
			        TRUE(),
			        Change > 0, "▲ ",
			        Change < 0, "▼ ",
			        "→ "
			    )
			
			RETURN
			    IF(
			        ISBLANK(PreviousValue),
			        BLANK(),
			        Arrow &
			        FORMAT(ABS(Change), "0")
			        & " ("
			        & FORMAT(ABS(ChangePct), "0.0%")
			        & ")"
			    )
		lineageTag: 7fc502ac-d75e-4f93-b8d3-fcf98b07cb11

	measure 'Rolling 1M - MoM Color' =
			
			VAR Change =
			    [Rolling 1M - Current]
			        - [Rolling 1M - Previous]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        Change > 0, "#2E7D32",
			        Change < 0, "#D64545",
			        "#6B7280"
			    )
		lineageTag: 004a90e5-0e01-4718-ad0e-adea7a018939

	measure 'Rolling 3M - Current' =
			
			VAR LatestMonth =
			    CALCULATE(
			        MAX('DIM_DATE'[Date]),
			        ALLSELECTED('DIM_DATE')
			    )
			
			VAR CurrentMonthEnd =
			    EOMONTH(LatestMonth, 0)
			
			VAR CurrentMonthStart =
			    EOMONTH(LatestMonth, -3) + 1
			
			RETURN
			CALCULATE(
			    [Total RX Count],
			    REMOVEFILTERS('DIM_DATE'),
			    DATESBETWEEN(
			        'DIM_DATE'[Date],
			        CurrentMonthStart,
			        CurrentMonthEnd
			    )
			)
		formatString: 0.0
		lineageTag: a7955cca-310a-41cc-a33c-85ae169b0f36

	measure 'Rolling 3M - Previous' =
			
			VAR LatestMonth =
			    CALCULATE(
			        MAX('DIM_DATE'[Date]),
			        ALLSELECTED('DIM_DATE')
			    )
			
			VAR PreviousMonthEnd =
			    EOMONTH(LatestMonth, -3)
			
			VAR PreviousMonthStart =
