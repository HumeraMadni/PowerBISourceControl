			)
		formatString: $#,##0.0
		lineageTag: ad898def-6c8e-4c4d-9936-de7bb0d16898

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Zenpep RX (Coalesce)' =
			
			COALESCE(
