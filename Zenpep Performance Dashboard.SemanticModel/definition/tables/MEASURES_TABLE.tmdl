table MEASURES_TABLE
	lineageTag: c09d6498-62be-4501-b44e-a1a50a1260a3

	measure 'Total Claim Count' = COUNTROWS(GOLD_LAYER_FINAL_STATUS)
		formatString: 0
		lineageTag: 00443d13-db92-4950-b6f2-d84a37d156e3

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Total RX Count' = SUM ( GOLD_LAYER_FINAL_STATUS[RX_COUNT] ) -- Includes Zenpep and creon both and NTP 0 as well as 1
		formatString: 0.0
		lineageTag: 6b092800-d158-4bc6-8ce1-52d1e8858035

	measure 'Total Patients' = DISTINCTCOUNT(GOLD_LAYER_FINAL_STATUS[PATIENT_ID])
		formatString: 0
		lineageTag: b3aca921-9a59-4234-aa5a-135496fe9288

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Paid Claim Count' =
			
			CALCULATE(
			    [Total Claim Count],
			    'CLAIM_STATUS'[CLAIM_STATUS_NUM] = 1
			)
		formatString: 0
		lineageTag: 2b5945e5-fc20-453e-ad5d-dbb9ae38b66e

	measure 'Paid %' =
			
			DIVIDE(
			    [Paid Claim Count],
			    [Total Claim Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e080c59b-3463-4df8-844a-2889231ec0a6

	measure 'Reversed Claim Count' =
			
			CALCULATE(
			    [Total Claim Count],
			    'CLAIM_STATUS'[CLAIM_STATUS_NUM] = 2
			)
		formatString: 0
		lineageTag: 98e04e9d-645a-4419-acca-eece41b2c754

	measure 'Reversed %' =
			
			DIVIDE(
			    [Reversed Claim Count],
			    [Total Claim Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 516d9fa5-3cd4-4229-a471-05dc4a274639

	measure 'Average OOP' = AVERAGE(GOLD_LAYER_FINAL_STATUS[PATIENT_OUT_OF_POCKET])
		lineageTag: 34aac30a-0ae9-4107-b625-76d13122c9b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Creon 24K RX' =
			
			CALCULATE(
			    [Total RX Count],
			    'GOLD_LAYER_DRUG'[NEW_DRUG_NAME] = "Creon 24k"
			)
		formatString: 0.0
		lineageTag: 6fbcd1ef-8100-42b4-987a-3b4cd6c970d3

	measure 'Creon 24K %' =
			
			DIVIDE(
			    [Creon 24K RX],
			    [Total RX Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2c2fcf7b-9bac-4d76-88bd-de7a750d2407

	measure 'High Potential Flag Creon 24K Flag' =
			
			IF(
			    [Creon 24K %] > 0.60,
			    1,
			    0
			)
		formatString: 0
		lineageTag: a7f43289-8aaa-49ca-bd22-cadf9f994f7a

	measure 'High Potential HCP Count' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('GOLD_LAYER_HCP_SHORT'[PRACTITIONER_ID]),
			        [High Potential Flag Creon 24K Flag] = 1
			    )
			)
		formatString: 0
		lineageTag: 7ff92761-4133-4097-9267-d432464d63fd

	measure 'Creon 36K RX' =
			
